{
  "name": "haikuandhue",
  "version": "0.1.0",
  "private": true,
  "description": "A feeling. Three lines. A little color. A daily haiku studio that turns moods into poetry and matching artwork.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
