{
  "name": "haiku-and-hue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "owner:create": "node --env-file-if-exists=.env --import tsx scripts/create-owner.ts",
    "seed:demo": "node --env-file-if-exists=.env --import tsx scripts/seed-demo.ts",
    "queue:setup": "node --env-file-if-exists=.env --import tsx scripts/setup-queue.ts"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@prisma/client": "6.19.3",
    "next": "16.3.4",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "5.0.0"
  }
}
