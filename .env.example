# PostgreSQL database used by Next.js, Prisma, and the worker.
DATABASE_URL="postgresql://haikuandhue@localhost:5432/haikuandhue?schema=public"

# Server-side generation credentials. Leave blank for clearly labeled demo mode.
TEXT_MODEL_PROVIDER="demo"
TEXT_MODEL_API_KEY=""

# Authentication for private journal access. Generate these locally; do not commit real values.
APP_SECRET="replace-with-a-long-random-string"
APP_PASSWORD_HASH=""
# Optional development-only fallback if APP_PASSWORD_HASH is not set.
APP_PASSWORD="demo"

# Publishing credentials are intentionally separate from generation credentials.
PUBLISHING_VAULT_URL=""
