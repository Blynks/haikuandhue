DATABASE_URL=postgresql://localhost:5432/haiku
# Production worker MUST use the separately provisioned, restricted haiku_worker role.
WORKER_DATABASE_URL=postgresql://localhost:5432/haiku
# Add distinct URL-encoded database credentials to both URLs before running.
# Compose uses this administrator password for initial PostgreSQL creation.
POSTGRES_PASSWORD=
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
MEDIA_DRIVER=local
MEDIA_LOCAL_PATH=./data/media
# Private S3-compatible bucket; never set public ACLs.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local-only/demo is the default. Live calls require both saved remote opt-in and these settings.
TEXT_PROVIDER=demo
TEXT_API_URL=
TEXT_API_ALLOWED_HOST=
TEXT_API_KEY=
TEXT_MODEL=
TEXT_COST_CENTS=2
MAX_HAIKUS=8
MAX_ARTWORKS=8
NOTIFICATION_DRIVER=inbox
NEXT_TELEMETRY_DISABLED=1
# Set these only for CLI owner creation; do not expose to web or worker containers.
OWNER_EMAIL=
OWNER_PASSWORD=
